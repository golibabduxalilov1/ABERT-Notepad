<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen alarm shown over the lock screen (AlarmActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF111827"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_alarm_large" />

    <TextView
        android:id="@+id/alarm_window"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="#FB923C"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarm_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="6"
        android:textColor="#D1D5DB"
        android:textSize="16sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/alarm_snooze_10"
            style="@style/AlarmScreenButton"
            android:layout_marginEnd="10dp"
            android:text="+10 мин" />

        <TextView
            android:id="@+id/alarm_snooze_15"
            style="@style/AlarmScreenButton"
            android:layout_marginEnd="10dp"
            android:text="+15 мин" />

        <TextView
            android:id="@+id/alarm_snooze_30"
            style="@style/AlarmScreenButton"
            android:text="+30 мин" />
    </LinearLayout>

    <TextView
        android:id="@+id/alarm_pause"
        style="@style/AlarmScreenButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_weight="0"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_notif_btn_primary"
        android:textColor="#FFFFFF"
        android:text="⏸ Пауза" />

    <TextView
        android:id="@+id/alarm_open"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="Открыть приложение"
        android:textColor="#9CA3AF"
        android:textSize="15sp" />
</LinearLayout>
