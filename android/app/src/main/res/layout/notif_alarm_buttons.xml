<?xml version="1.0" encoding="utf-8"?>
<!-- Shared row of the four alarm buttons, included by the heads-up and expanded layouts -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/btn_snooze_30"
        style="@style/NotifAlarmButton"
        android:layout_marginEnd="6dp"
        android:text="+30 мин" />

    <TextView
        android:id="@+id/btn_snooze_10"
        style="@style/NotifAlarmButton"
        android:layout_marginEnd="6dp"
        android:text="+10 мин" />

    <TextView
        android:id="@+id/btn_snooze_15"
        style="@style/NotifAlarmButton"
        android:layout_marginEnd="6dp"
        android:text="+15 мин" />

    <TextView
        android:id="@+id/btn_pause"
        style="@style/NotifAlarmButton"
        android:background="@drawable/bg_notif_btn_primary"
        android:textColor="#FFFFFF"
        android:text="⏸ Пауза" />
</LinearLayout>
